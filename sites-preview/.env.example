# keyrig Worker variables. Set these in the Sites/Cloudflare dashboard.
# Use long random values. Never commit a real value.

# Required for the optional backend. It signs the session cookie.
# The backend refuses every call when this is missing or shorter than 16 characters.
BACKEND_SESSION_SALT=replace-with-a-long-random-value

# Required for the first account on a new deployment. The first sign-up must
# send this value in the x-keyrig-setup-token header. At least 16 characters.
FIRST_OWNER_TOKEN=replace-with-a-long-random-value

# Required for the hosted model route.
CF_ACCOUNT_ID=replace-with-the-cloudflare-account-id
CF_AI_TOKEN=replace-with-a-workers-ai-token
HOSTED_IP_SALT=replace-with-a-long-random-value
